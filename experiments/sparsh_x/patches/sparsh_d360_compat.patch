-        return image and "image_raw" in topic
+        # COMPATIBILITY PATCH: narrowed from "image_raw" in topic. Our
+        # recordings publish both an uncompressed "/image_raw/index_N" topic
+        # and the "/image_raw/compressed/index_N" topic their pipeline
+        # expects (the only one with a slot in the subtopics dict below);
+        # the loose substring match matched both and crashed on the
+        # uncompressed one (KeyError on append). Require the exact
+        # compressed subtopic so the raw variant is rejected by design, not
+        # silently skipped.
+        return image and "image_raw/compressed" in topic
 
     def check_audio(topic: str):
         return audio and "mic" in topic and "spec" not in topic
