+# ── COMPATIBILITY PATCH (not part of Meta's original data processing logic) ──
+# This repo's own D360 recordings namespace topics as "/d360_N/<subtopic>"
+# (device prefix). Our recordings (tactile project, no multi-device rig) use
+# "/<subtopic>/index_N" instead (device index as a trailing suffix, no
+# "d360_N" prefix at all), so the original substring filter ('"d360" in
+# channel.topic') and the "d360_N/subtopic" string-slicing below never
+# matched anything -- 0 messages were read. This helper rewrites our
+# convention into their expected "/d360_N/<subtopic>" string so every
+# downstream line (unchanged) works the same for both conventions. It does
+# NOT alter what data is extracted or how it's processed -- only which raw
+# topic strings are recognized as belonging to a D360 device.
+_OUR_TOPIC_SUFFIX_RE = re.compile(r"^/(.+)/index_(\d+)$")
+
+
+def _normalize_d360_topic(topic: str) -> str:
+    if "/d360_" in topic:
+        return topic  # already their native convention, unchanged
+    m = _OUR_TOPIC_SUFFIX_RE.match(topic)
+    if m:
+        subtopic, device_idx = m.group(1), m.group(2)
+        return f"/d360_{device_idx}/{subtopic}"
+    return topic  # not a D360 topic either way (e.g. /rosout) -- unchanged
+
+
